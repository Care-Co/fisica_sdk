# Source distributions are disabled in setup.py; this is defense in depth.
include Readme.md
include LICENSE
prune native
prune tools
prune tests
prune examples
prune .build
prune .venv
prune wrappers
exclude sampledata.md
global-exclude *.cpp *.cc *.c *.pyx *.pdb *.dSYM *.pyc *.lib *.exp *.obj *.ilk *.idb
